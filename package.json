{
  "name": "smallbusiness-footprint",
  "version": "1.1.0",
  "description": "TypeScript commerce workflows and business profiles on Blueprint: scoped actions, shipping, after-sales and retained operation evidence.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node scripts/developer/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "quickstart:booking": "node examples/shared-evidence/booking.mjs",
    "quickstart:publication": "node examples/shared-evidence/publication.mjs",
    "test:developer-package": "node --test scripts/developer/pack.test.mjs",
    "docs:flows": "node scripts/developer/flow-docs.mjs --write",
    "check:flow-docs": "node scripts/developer/flow-docs.mjs --check",
    "test:flow-docs": "node --test scripts/developer/flow-docs.test.mjs scripts/developer/application-catalog.test.mjs"
  },
  "dependencies": {
    "footprint-blueprint": "1.1.0",
    "footprintjs": "12.0.0",
    "zod": "4.6.5",
    "foottrace": "1.15.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@babel/parser": "8.1.2"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md",
    "examples/shared-evidence/*.mjs",
    "examples/developer/*.mjs"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    },
    "./shipping": {
      "types": "./dist/shipping.d.ts",
      "import": "./dist/shipping.js",
      "default": "./dist/shipping.js"
    },
    "./aftersales": {
      "types": "./dist/aftersales.d.ts",
      "import": "./dist/aftersales.js",
      "default": "./dist/aftersales.js"
    },
    "./aftersales/runtime": {
      "types": "./dist/aftersales/runtime.d.ts",
      "import": "./dist/aftersales/runtime.js",
      "default": "./dist/aftersales/runtime.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js",
      "default": "./dist/diagnostics.js"
    },
    "./diagnostics/runtime": {
      "types": "./dist/diagnostics/runtime.d.ts",
      "import": "./dist/diagnostics/runtime.js",
      "default": "./dist/diagnostics/runtime.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./developer": {
      "types": "./dist/developer/index.d.ts",
      "import": "./dist/developer/index.js",
      "default": "./dist/developer/index.js"
    },
    "./developer/node": {
      "types": "./dist/developer/node.d.ts",
      "import": "./dist/developer/node.js",
      "default": "./dist/developer/node.js"
    },
    "./developer/source-manifest.json": "./dist/developer/source-manifest.json",
    "./diagnostics/cause": {
      "types": "./dist/diagnostics/aftersalesCause.d.ts",
      "import": "./dist/diagnostics/aftersalesCause.js",
      "default": "./dist/diagnostics/aftersalesCause.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./developer/application": {
      "types": "./dist/developer/application.d.ts",
      "import": "./dist/developer/application.js",
      "default": "./dist/developer/application.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footprintjs/smallbusiness-footprint.git"
  },
  "homepage": "https://github.com/footprintjs/smallbusiness-footprint#readme",
  "bugs": {
    "url": "https://github.com/footprintjs/smallbusiness-footprint/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "typescript",
    "commerce",
    "ecommerce",
    "business-profiles",
    "workflow",
    "shipping",
    "execution-provenance",
    "footprintjs"
  ],
  "bin": {
    "smallbusiness-context": "dist/developer/application-cli.js"
  }
}
