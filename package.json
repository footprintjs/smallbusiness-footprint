{
  "name": "smallbusiness-footprint",
  "version": "0.5.0",
  "description": "Small-business e-commerce domain wrapper for footprint-blueprint \u2014 configurable commerce engine for any shop type",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "quickstart:booking": "node examples/shared-evidence/booking.mjs",
    "quickstart:publication": "node examples/shared-evidence/publication.mjs"
  },
  "dependencies": {
    "footprint-blueprint": "0.5.0",
    "footprintjs": "10.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md",
    "examples/shared-evidence/*.mjs"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    },
    "./shipping": {
      "types": "./dist/shipping.d.ts",
      "import": "./dist/shipping.js",
      "default": "./dist/shipping.js"
    },
    "./aftersales": {
      "types": "./dist/aftersales.d.ts",
      "import": "./dist/aftersales.js",
      "default": "./dist/aftersales.js"
    },
    "./aftersales/runtime": {
      "types": "./dist/aftersales/runtime.d.ts",
      "import": "./dist/aftersales/runtime.js",
      "default": "./dist/aftersales/runtime.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js",
      "default": "./dist/diagnostics.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footprintjs/smallbusiness-footprint.git"
  },
  "homepage": "https://github.com/footprintjs/smallbusiness-footprint#readme",
  "bugs": {
    "url": "https://github.com/footprintjs/smallbusiness-footprint/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
