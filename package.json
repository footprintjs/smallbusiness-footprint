{
  "name": "smallbusiness-footprint",
  "version": "0.3.0",
  "description": "Small-business e-commerce domain wrapper for footprint-blueprint — configurable commerce engine for any shop type",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "quickstart:booking": "node examples/shared-evidence/booking.mjs",
    "quickstart:publication": "node examples/shared-evidence/publication.mjs"
  },
  "dependencies": {
    "footprint-blueprint": "workspace:*",
    "footprintjs": "10.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@types/node": "24.19.2"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.11.2",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md",
    "examples/shared-evidence/*.mjs"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footprintjs/smallbusiness-footprint.git"
  },
  "homepage": "https://github.com/footprintjs/smallbusiness-footprint#readme",
  "bugs": {
    "url": "https://github.com/footprintjs/smallbusiness-footprint/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
